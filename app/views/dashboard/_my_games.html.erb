<% viewer = local_assigns[:viewer] || Current.user %>
<h2><%= local_assigns[:title] || "My Games" %></h2>
<% games.each do |game| %>
  <div class="game-row <%= 'my-turn' if game.my_turn?(viewer) %>">
    <% if game.playing? %>
      <span class="pulser">
        <% if game.my_turn?(viewer) %>
          ●
        <% else %>
          &nbsp;
        <% end %>
      </span>
      <%= link_to game_path(game) do %>
        <span>
          Game <%= game.id %> with <%= rated_list(game) %> &mdash; <%= game.turn_state %>
          <% if game.speed_label %>
            <span class="speed-badge"><%= game.speed_label %></span>
          <% end %>
        </span>
      <% end %>
    <% else %>
      <span>
        Game <%= game.id %> with <%= rated_list(game) %> &mdash; <%= game.turn_state %>
        <% if game.speed_label %>
          <span class="speed-badge"><%= game.speed_label %></span>
        <% end %>
      </span>
    <% end %>
    <div class="game-options"><%= game.options_label %></div>
    <% if game.invited_user %>
      <div class="game-options">Invited: <%= game.invited_user.handle %></div>
    <% end %>
    <% if game.waiting? && game.opener == viewer %>
      <%= button_to "Cancel table", cancel_game_path(game), data: { turbo_confirm: "Cancel this table?" } %>
    <% end %>
  </div>
  <br/>
<% end %>
<% unless local_assigns[:title] %>
  <br/>
  <h3><%= link_to "Open a new table", new_game_path %></h3>
<% end %>
