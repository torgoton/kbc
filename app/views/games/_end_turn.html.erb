<% my_turn = local_assigns.fetch(:my_turn, false) %>
<% my_player = local_assigns[:my_player] %>
<span id="my-turn-flag" data-my-turn="<%= my_turn %>" hidden></span>
<% if my_turn && engine.canoe_confirmation? %>
  <%= button_to "Confirm", confirm_canoe_game_path(game) %>
<% elsif my_turn && engine.canoe_reaction? %>
  <%= button_to "Skip Canoe", skip_canoe_game_path(game) %>
<% elsif my_turn && engine.silo_prompt? %>
  <% %w[build move skip].each do |mode| %>
    <%= button_to mode.capitalize, silo_choice_game_path(game, mode:) %>
  <% end %>
<% elsif my_turn && engine.tile_action_endable? %>
  <%= button_to "End action", end_tile_action_game_path(game) %>
<% elsif my_turn && engine.turn_endable? %>
  <%= button_to "End turn", end_turn_game_path(game) %>
<% end %>
<% if my_turn && (piece_choices = engine.temple_piece_choices).size > 1 %>
  <% piece_choices.each do |piece| %>
    <%= button_to piece.capitalize, choose_temple_piece_game_path(game, piece:),
        class: ("selected" if my_player&.next_temple_piece(game.mandatory_count) == piece), form_class: "temple-choice" %>
  <% end %>
<% end %>
<% if my_player && game.potential_claimant?(my_player.player) %>
  <div data-controller="claim-victory"<%= " hidden" unless game.claimable_by?(my_player.player) %>>
    <%= button_to "Claim victory", claim_victory_game_path(game), class: "claim-victory-btn",
        data: { turbo_confirm: "The current player's clock has run out. Claim victory and end the game?" } %>
  </div>
<% end %>
