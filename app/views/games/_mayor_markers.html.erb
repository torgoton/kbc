<div class="mayor-markers">
  <% game.game_players.each do |gp| %>
    <% Array(gp.supply["mayors"]).select { |row| rows.cover?(row) }.each do |row| %>
      <div class="mayor-marker" style="--row: <%= row % 10 %>">
        <%= render "games/settlement", color: player_color(gp.order), css_class: "" %>
      </div>
    <% end %>
  <% end %>
</div>
