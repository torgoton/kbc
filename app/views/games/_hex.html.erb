<%# One playable hex, shared by the main-map quadrants and the Island.
    Locals: game, board_row, board_col, terrain (lowercase letter), top_row, silver_css, silver_desc, side (optional) %>
<% content = game.board.content_at(board_row, board_col) %>
<%# div for the hex %>
<%= content_tag :div,
  id: "map-cell-#{board_row}-#{board_col}",
  class: [
    "hex",
    "terrain-#{terrain}",
    board_row.even? ? "even" : "odd",
    local_assigns[:side] || (board_col < 10 ? "left" : "right"),
    top_row ? "top-row" : nil,
    (!%w[l s].include?(terrain)) && game.board_contents.warrior_blocked?(board_row, board_col) ? "warrior-blocked" : nil
  ].compact.join(" ") do %>
  <div class="hex-bg"></div>
  <div class="terrain-icon"></div>
  <% if game.volcano_hex == [ board_row, board_col ] %>
    <div class="volcano-icon"></div>
    <svg class="volcano-ring" viewBox="0 0 100 115.47" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg"><polygon points="50,0 100,28.87 100,86.60 50,115.47 0,86.60 0,28.87"/></svg>
    <div class="tile-tooltip"><%= Game::DECREES["volcano"][:description] %></div>
  <% end %>
  <% if game.ferry_hex == [ board_row, board_col ] %>
    <div class="ferry-icon"></div>
    <svg class="ferry-ring" viewBox="0 0 100 115.47" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg"><polygon points="50,0 100,28.87 100,86.60 50,115.47 0,86.60 0,28.87"/></svg>
    <div class="tile-tooltip"><%= Game::DECREES["ferry"][:description] %></div>
  <% end %>
  <svg class="hex-outline" viewBox="0 0 100 115.47" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg"><polygon points="50,0 100,28.87 100,86.60 50,115.47 0,86.60 0,28.87"/></svg>
  <% if terrain == "s" && !content.is_a?(Tiles::Tile) %>
    <%= content_tag :div, nil, class: silver_css %>
    <% if (silver_description = silver_desc) %>
      <div class="tile-tooltip"><%= silver_description %></div>
    <% end %>
  <% end %>
  <% if content %>
    <%# div for the hex content %>
    <%= content_tag :div, class: "cell-content" do %>
      <%# show the pieces on top of the board %>
      <% case content %>
      <% when Tiles::Tile %>
        <% content_class = content.tile_css_class %>
        <%= content_tag :div, nil, class: "tile-container #{content_class}" do %>
          <%# show quantity if any %>
          <% if content.respond_to? :qty %>
            <%= content_tag :div, content.qty, class: "tile-counter" %>
          <% end %>
        <% end %>
        <div class="tile-tooltip"><%= content.description.html_safe %></div>
      <% when Settlement %>
        <% meeple_tile_active = %w[BarracksTile LighthouseTile WagonTile].include?(game.current_action["klass"]) %>
        <% show_popup = meeple_tile_active && content.player == game.current_player&.order %>
        <% if show_popup && (content.warrior? || content.ship? || content.wagon?) %>
          <div data-controller="meeple-popup"
               data-action="click->meeple-popup#toggle">
            <% if content.warrior? %>
              <%= render "games/warrior", color: player_color(content.player), css_class: "hex-settlement" %>
            <% elsif content.ship? %>
              <%= render "games/ship", color: player_color(content.player), css_class: "hex-settlement" %>
            <% else %>
              <%= render "games/wagon", color: player_color(content.player), css_class: "hex-settlement" %>
            <% end %>
            <div data-meeple-popup-target="popup" class="meeple-popup hidden">
              <%= button_to "Remove",
                    remove_meeple_game_path(game),
                    params: { row: board_row, col: board_col },
                    class: "popup-btn",
                    data: { turbo_stream: true } %>
              <% if content.ship? || content.wagon? %>
                <%= button_to "Move",
                      select_meeple_game_path(game),
                      params: { row: board_row, col: board_col },
                      class: "popup-btn",
                      data: { turbo_stream: true } %>
              <% end %>
              <button data-action="click->meeple-popup#cancel" class="popup-btn popup-btn-cancel">Cancel</button>
            </div>
          </div>
        <% elsif content.warrior? %>
          <%= render "games/warrior", color: player_color(content.player), css_class: "hex-settlement" %>
        <% elsif content.ship? %>
          <%= render "games/ship", color: player_color(content.player), css_class: "hex-settlement" %>
        <% elsif content.wagon? %>
          <%= render "games/wagon", color: player_color(content.player), css_class: "hex-settlement" %>
        <% elsif content.city_hall? %>
          <div class="city-hall-bg" style="background-color: <%= player_color(content.player) %>"></div>
          <%= render "games/settlement", color: player_color(content.player), css_class: "hex-settlement city-hall-settlement" %>
        <% else %>
          <%= render "games/settlement", color: player_color(content.player), css_class: "hex-settlement" %>
        <% end %>
      <% when Wall %>
        <%= content_tag :div, nil, class: "hex-wall" %>
      <% when Scout %>
        <%= render "games/scout", color: player_color(content.player), css_class: "hex-scout" %>
      <% else %>
        <%= content_tag :div, nil, class: "hex-mystery" %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
