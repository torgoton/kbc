<%= content_tag :div,
  class: ["quadrant",
    index.odd? ? "right" : "left",
    index >=2 ? "bottom" : "top"
    ].compact.join(" ") do %>
  <% 10.times do |row| %>
    <% if row.odd? %>
      <div class="spacer"></div>
    <% end %>
    <% 10.times do |col| %>
      <% board_row = row + 10 * (index / 2) %>
      <% board_col = col + 10 * (index % 2) %>
      <% terrain = quadrant ? quadrant.terrain_at(row, col).downcase : "" %>
      <%= render "games/hex", game:, board_row:, board_col:, terrain:, top_row: index < 2,
            silver_css: (quadrant.silver_hex_css_class(row, col) if terrain == "s"),
            silver_desc: (quadrant.silver_hex_description(row, col) if terrain == "s") %>
    <% end %>
    <% if row.even? %>
      <div class="spacer"></div>
    <% end %>
  <% end %>
<% end %>
